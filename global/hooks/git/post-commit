#!/usr/bin/env bash
# post-commit — fleet pass-through stub (CFG-892). The global core.hooksPath that arms the
# pre-push credential scan would otherwise silently disable this repo's own post-commit
# hook (git-lfs installs one). This stub only chains <toplevel>/.githooks/post-commit and
# then <git-common-dir>/hooks/post-commit — same args, same stdin, first non-zero exit
# wins. No scan here; see pre-push and _chain.sh.
exec bash "$(dirname "${BASH_SOURCE[0]}")/_chain.sh" "$(basename "${BASH_SOURCE[0]}")" "$@"
