#!/usr/bin/env bash
# prepare-commit-msg — fleet pass-through stub (CFG-892). The global core.hooksPath that
# arms the pre-push credential scan would otherwise silently disable this repo's own
# prepare-commit-msg hook. This stub only chains <toplevel>/.githooks/prepare-commit-msg
# and then <git-common-dir>/hooks/prepare-commit-msg — same args, same stdin, first
# non-zero exit wins. No scan here; see pre-push and _chain.sh.
exec bash "$(dirname "${BASH_SOURCE[0]}")/_chain.sh" "$(basename "${BASH_SOURCE[0]}")" "$@"
