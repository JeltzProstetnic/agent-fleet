#!/usr/bin/env bash
# pre-merge-commit — fleet pass-through stub (CFG-892). The global core.hooksPath that
# arms the pre-push credential scan would otherwise silently disable this repo's own
# pre-merge-commit hook. This stub only chains <toplevel>/.githooks/pre-merge-commit and
# then <git-common-dir>/hooks/pre-merge-commit — same args, same stdin, first non-zero
# exit wins. No scan here; see pre-push and _chain.sh.
exec bash "$(dirname "${BASH_SOURCE[0]}")/_chain.sh" "$(basename "${BASH_SOURCE[0]}")" "$@"
