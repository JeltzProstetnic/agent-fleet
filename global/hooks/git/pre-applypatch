#!/usr/bin/env bash
# pre-applypatch — fleet pass-through stub (CFG-892). The global core.hooksPath that arms
# the pre-push credential scan would otherwise silently disable this repo's own
# pre-applypatch hook. This stub only chains <toplevel>/.githooks/pre-applypatch and then
# <git-common-dir>/hooks/pre-applypatch — same args, same stdin, first non-zero exit
# wins. No scan here; see pre-push and _chain.sh.
exec bash "$(dirname "${BASH_SOURCE[0]}")/_chain.sh" "$(basename "${BASH_SOURCE[0]}")" "$@"
