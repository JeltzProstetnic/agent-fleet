# VPS Secrets — Copy to secrets.env and fill in values
# NEVER commit secrets.env — only this template is tracked
#
# SECURITY: Fill in values by editing this file directly in your editor.
# Never paste tokens into a Claude Code chat session — session transcripts
# may be logged. Edit this file, then run bootstrap.sh.

# Anthropic (required)
ANTHROPIC_API_KEY=

# GitHub MCP server
GITHUB_PERSONAL_ACCESS_TOKEN=

# Twitter MCP server
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Google Workspace MCP server
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_USER_EMAIL=__YOUR_EMAIL__
