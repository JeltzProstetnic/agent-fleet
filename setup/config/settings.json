{
  "spinnerTipsEnabled": false,
  "env": {
    "CC_MIRROR_SPLASH": "1",
    "CC_MIRROR_PROVIDER_LABEL": "Mirror Claude",
    "CC_MIRROR_SPLASH_STYLE": "fleet",
    "CC_MIRROR_DIR": "__HOME__/.cc-mirror/mclaude",
    "TWEAKCC_CONFIG_DIR": "__HOME__/.cc-mirror/mclaude/tweakcc",
    "CLAUDE_CODE_TEAM_MODE": "1",
    "CLAUDE_CODE_AGENT_TYPE": "team-lead",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "0",
    "FORCE_COLOR": "1",
    "COLORTERM": "truecolor",
    "CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS": "10000",
    "TERM_PROGRAM_INHIBIT_ALTSCREEN": "1",
    "CLAUDE_CODE_DISABLE_VIRTUAL_SCROLL": "1"
  },
  "permissions": {
    "allow": [
      "Skill(orchestration)",
      "WebSearch",
      "WebFetch(domain:*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Write(*)",
      "Edit(*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(env:*)",
      "Bash(wc:*)",
      "Bash(tr:*)",
      "Bash(tput:*)",
      "Bash(command:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(pwd:*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(uvx:*)",
      "Bash(curl:*)",
      "Bash(dotnet:*)",
      "Bash(gh:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(kill:*)",
      "Bash(docker:*)",
      "Bash(timeout:*)",
      "Bash(powershell.exe:*)",
      "Bash(cc-mirror:*)",
      "Bash(mclaude:*)",
      "Bash(pipx:*)",
      "Bash(pip3:*)",
      "Bash(qdbus:*)",
      "Bash(jq:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(tmux:*)",
      "Bash(nvm:*)",
      "Bash(printf:*)",
      "Bash(du:*)",
      "Bash(readlink:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(realpath:*)",
      "Bash(wslpath:*)",
      "Bash(bash:*)",
      "Bash(test:*)",
      "Bash(sleep:*)",
      "Bash(xdg-open:*)",
      "mcp__serena__*",
      "mcp__workspace__*",
      "mcp__github__*",
      "mcp__playwright__*",
      "mcp__diagram__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh config-check.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh context-budget.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh afk-deactivate.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh config-auto-sync.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh afd-relay.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh risk-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh auto-lint.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh critical-edit-notify.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh commit-verify.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/safe-run.sh tool-install-detect.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {}
}
