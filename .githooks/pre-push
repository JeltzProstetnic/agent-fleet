#!/usr/bin/env bash
# Pre-push hook: block push if personal data patterns found in tracked files.
# Install: git config core.hooksPath .githooks
# Part of agent-fleet template safety (CFG-295).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Personal data patterns — must not appear in the public template.
# Pipe-separated grep -E regex. Keep in sync with cfg-agent-fleet template-push.conf.
PATTERNS='(JeltzProstetnic|jeltz\.prostetnic|Matthias Gruber|matthias@matthiasgruber\.com|gutachten@matthiasgruber\.com|bartl@matthiasgruber\.com|srv943133|DESKTOP-32ILURB|148\.230\.108\.107|109\.106\.246\.63|Ivoclar)'

# File extensions to scan
EXTENSIONS='--include=*.md --include=*.sh --include=*.json --include=*.yml --include=*.yaml --include=*.conf --include=*.js'

# Scan tracked files (not .git/)
# Exclusions: pattern definitions, test files, GitHub repo URLs, security audit references
matches=$(grep -rn $EXTENSIONS -E "$PATTERNS" "$REPO_ROOT" \
    --exclude-dir=.git \
    --exclude-dir=.githooks \
    2>/dev/null \
    | grep -v "PATTERNS=" \
    | grep -v "personal_patterns=" \
    | grep -v 'setup/tests/' \
    | grep -v 'github\.com/JeltzProstetnic/agent-fleet' \
    | grep -v 'Security audit.*JeltzProstetnic' \
    || true)

if [[ -n "$matches" ]]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  BLOCKED: Personal data found in template repo          ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    echo "$matches"
    echo ""
    echo "Fix: remove personal data before pushing."
    echo "Bypass (emergency only): git push --no-verify"
    exit 1
fi

# Check for volatile files that shouldn't have content
_check_volatile() {
    local file="$1" pattern="$2" label="$3"
    if [[ -f "$REPO_ROOT/$file" ]] && grep -qE "$pattern" "$REPO_ROOT/$file" 2>/dev/null; then
        echo "  VOLATILE: $file contains $label"
        return 1
    fi
    return 0
}

volatile_fail=0
_check_volatile "cross-project/inbox.md" '^\- \[.\] \*\*' "task entries" || volatile_fail=1
_check_volatile "docs/session-log.md" '^### [0-9]{4}-[0-9]{2}-[0-9]{2}' "session entries" || volatile_fail=1

if [[ "$volatile_fail" -eq 1 ]]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  BLOCKED: Volatile personal state in template repo      ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    echo "Fix: clean volatile files before pushing."
    exit 1
fi

exit 0
