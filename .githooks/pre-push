#!/usr/bin/env bash
# Pre-push hook: block push if identifier-shaped tokens are found in tracked files.
# Install: git config core.hooksPath .githooks  (setup/scripts/ensure-githooks.sh)
# Part of agent-fleet template safety (CFG-295).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Pattern SHAPES only (CFG-869): a home directory, a hostname class, an IPv4 address,
# an e-mail address — defined once in leak-shapes.sh and shared with the smoke test.
# The literal list of one deployment's own identifiers would itself publish them
# (owner, hosts, addresses, employer, all linked), so it lives OUTSIDE the tree: for
# the fleet that maintains this template in its private template-push.conf; for any
# clone in the optional, gitignored .githooks/personal-patterns.local (format: the
# .example beside it), sourced here when present. It may define PERSONAL_PATTERNS
# (a grep -E alternation of literals to block) and PERSONAL_ALLOW (a grep -E over
# whole lines that exempts a form published on purpose, e.g. the clone URL).
# shellcheck source=leak-shapes.sh
source "$REPO_ROOT/.githooks/leak-shapes.sh"
PERSONAL_PATTERNS=""; PERSONAL_ALLOW=""
if [[ -f "$REPO_ROOT/.githooks/personal-patterns.local" ]]; then
    # shellcheck source=/dev/null
    source "$REPO_ROOT/.githooks/personal-patterns.local"
fi

# What is being PUSHED, not what is on disk (CFG-555): git hands pre-push one line
# per ref — "<local ref> <local sha> <remote ref> <remote sha>". A gitignored or
# uncommitted file can never reach the remote, so it must never block. A branch
# delete (all-zero local sha) pushes no content. Run by hand with no refs: HEAD.
SHAS=()
_refs_given=0
if [[ ! -t 0 ]]; then
    while read -r _lref _lsha _rref _rsha; do
        [[ -n "${_lref:-}" ]] || continue
        _refs_given=1
        [[ "$_lsha" =~ ^0+$ ]] && continue      # branch delete: no content
        SHAS+=("$_lsha")
    done
fi
[[ "$_refs_given" -eq 0 ]] && SHAS=("$(git -C "$REPO_ROOT" rev-parse HEAD)")

# Scan the pushed trees' text files. Excluded: .githooks/ (defines the shapes) and
# setup/tests/ (fixtures are identifier-shaped on purpose).
# Pass 1, shapes: -o so that SHAPE_ALLOW judges the matched TOKEN, not the line.
# Pass 2, the local literal list if any, over whole lines, minus PERSONAL_ALLOW.
matches=""
for _sha in "${SHAS[@]}"; do
    _m=$(git -C "$REPO_ROOT" grep -n -o -E "$SHAPE_PATTERNS" "$_sha" -- \
            "${SCAN_PATHSPECS[@]}" ':!.githooks' 2>/dev/null \
        | grep -v ':setup/tests/' \
        | grep -vE "$SHAPE_ALLOW" \
        || true)
    matches+="${_m:+$_m$'\n'}"
    if [[ -n "$PERSONAL_PATTERNS" ]]; then
        _p=$(git -C "$REPO_ROOT" grep -n -E "$PERSONAL_PATTERNS" "$_sha" -- \
                "${SCAN_PATHSPECS[@]}" ':!.githooks' 2>/dev/null \
            | grep -v ':setup/tests/' \
            | grep -v 'personal_patterns=' \
            || true)
        if [[ -n "$PERSONAL_ALLOW" && -n "$_p" ]]; then
            _p=$(printf '%s\n' "$_p" | grep -vE "$PERSONAL_ALLOW" || true)
        fi
        matches+="${_p:+$_p$'\n'}"
    fi
done
matches=$(printf '%s' "$matches" | sed '/^$/d')

if [[ -n "$matches" ]]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  BLOCKED: Personal data found in template repo          ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    echo "$matches"
    echo ""
    echo "Fix: remove personal data before pushing. A placeholder that is legitimately"
    echo "identifier-shaped goes into SHAPE_ALLOW in .githooks/leak-shapes.sh."
    echo "Bypass (emergency only): git push --no-verify"
    exit 1
fi

# Check for volatile files that shouldn't have content
_check_volatile() {
    local file="$1" pattern="$2" label="$3"
    local _s
    for _s in "${SHAS[@]}"; do
        if git -C "$REPO_ROOT" show "$_s:$file" 2>/dev/null | grep -qE "$pattern"; then
            echo "  VOLATILE: $file contains $label"
            return 1
        fi
    done
    return 0
}

volatile_fail=0
_check_volatile "cross-project/inbox.md" '^\- \[.\] \*\*' "task entries" || volatile_fail=1
_check_volatile "docs/session-log.md" '^### [0-9]{4}-[0-9]{2}-[0-9]{2}' "session entries" || volatile_fail=1

if [[ "$volatile_fail" -eq 1 ]]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  BLOCKED: Volatile personal state in template repo      ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    echo "Fix: clean volatile files before pushing."
    exit 1
fi

exit 0
